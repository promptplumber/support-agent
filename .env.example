# Copy this file to .env and fill in real values. .env is gitignored.

# OpenAI (used from Week 1 Day 3 onward for the LLM calls)
OPENAI_API_KEY=sk-...

# Langfuse tracing (free cloud account at langfuse.com -> project settings)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region default. Use https://us.cloud.langfuse.com for the US region.
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional limits (defaults shown)
# MAX_MESSAGE_CHARS=4000   # /chat rejects longer messages with 413, before any LLM call
# MAX_ANSWER_TOKENS=500    # ceiling on tokens the model may write per call
